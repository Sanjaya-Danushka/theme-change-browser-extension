{
  "manifest_version": 3,
  "name": "Theme Color Changer",
  "version": "1.0.0",
  "description": "Change website theme colors with predefined color schemes",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}